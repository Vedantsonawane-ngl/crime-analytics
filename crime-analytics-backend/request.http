### =====================================================
### 1. REGISTER USER
### =====================================================

POST http://localhost:9090/api/auth/register
Content-Type: application/json

{
    "name": "Yadnyesh",
    "email": "yadnyesh@example.com",
    "password": "mypassword123"
}


### =====================================================
### 2. LOGIN
### =====================================================

POST http://localhost:9090/api/auth/login
Content-Type: application/json

{
    "email": "yadnyesh@example.com",
    "password": "mypassword123"
}


### =====================================================
### 3. CREATE CRIME
### =====================================================

POST http://localhost:9090/api/crimes
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ5YWRueWVzaEBleGFtcGxlLmNvbSIsImlhdCI6MTc4NDczMzM1MywiZXhwIjoxNzg0NzM2OTUzfQ.MqmVEs0eJ02WHStRlxaLyAngkDHSrE9KnlxnIWRDK_s

{
    "crimeName": "Cybercrime",
    "description": "Crimes involving computers, networks, or digital systems",
    "category": "Cyber Crime",
    "severity": "High"
}


